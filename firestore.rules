rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================================
    // HELPER FUNCTIONS & MASTER ACCESS CONTROL
    // ============================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isBootstrapAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'vinayalakshmi1021@gmail.com' ||
        request.auth.token.email == 'admin@communitymap.org'
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        isBootstrapAdmin() ||
        request.auth.token.role == 'admin' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().role == 'admin')
      );
    }

    function isModerator() {
      return isAuthenticated() && (
        isAdmin() ||
        request.auth.token.role == 'moderator' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (getUserData().role == 'moderator' || getUserData().role == 'admin'))
      );
    }

    function isValidCoordinate(lat, lng) {
      return lat is number && lat >= -90.0 && lat <= 90.0 &&
             lng is number && lng >= -180.0 && lng <= 180.0;
    }

    // ============================================================================
    // 1. USERS COLLECTION
    // ============================================================================
    match /users/{userId} {
      // Basic profile read is open for contributor attribution
      allow read: if true;

      // Create: Users can register their own document
      allow create: if isOwner(userId) && (
        isBootstrapAdmin() ||
        !('role' in request.resource.data) ||
        request.resource.data.role in ['guest', 'citizen', 'member']
      );

      // Update: Users can modify their own profile data, but cannot escalate role unless admin
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (isOwner(userId) && (
          !('role' in request.resource.data) ||
          request.resource.data.role == resource.data.role
        ))
      );

      // Delete: Strictly Admins
      allow delete: if isAdmin();
    }

    // ============================================================================
    // 2. ASSETS COLLECTION
    // ============================================================================
    match /assets/{assetId} {
      // Anyone can read verified assets and public directory listings
      allow read: if true;

      // Allow authenticated creation OR initial seed creation (resource == null)
      allow create: if request.auth != null || resource == null;

      // Update and delete require authentication
      allow update, delete: if request.auth != null;
    }

    // ============================================================================
    // 3. COMMUNITY NEEDS COLLECTIONS (both 'needs' and 'communityNeeds')
    // ============================================================================
    match /needs/{needId} {
      allow read: if true;

      // Allow authenticated creation OR initial seed creation (resource == null)
      allow create: if request.auth != null || resource == null;

      allow update: if request.auth != null || 
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes', 'upvotedBy', 'updatedAt']));

      allow delete: if request.auth != null;
    }

    match /communityNeeds/{needId} {
      allow read: if true;

      allow create: if isAuthenticated() &&
        (request.resource.data.createdBy == request.auth.uid || request.resource.data.submittedBy == request.auth.uid) &&
        isValidCoordinate(request.resource.data.latitude, request.resource.data.longitude);

      allow update: if isAuthenticated() && (
        isModerator() ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes', 'upvotedBy', 'updatedAt'])) ||
        (resource.data.createdBy == request.auth.uid || resource.data.submittedBy == request.auth.uid)
      );

      allow delete: if isAuthenticated() && (
        isModerator() ||
        resource.data.createdBy == request.auth.uid ||
        resource.data.submittedBy == request.auth.uid
      );
    }

    // ============================================================================
    // 4. REPORTS COLLECTION (Inaccuracy Reports)
    // ============================================================================
    match /reports/{reportId} {
      // Inaccuracy reports can only be read by moderators/admins
      allow read: if isModerator();

      // Authenticated users can submit a report
      allow create: if isAuthenticated() &&
        (request.resource.data.reportedBy == request.auth.uid || request.resource.data.reporterId == request.auth.uid) &&
        request.resource.data.assetId is string;

      // Only moderators/admins can resolve or delete reports
      allow update, delete: if isModerator();
    }

    // ============================================================================
    // 5. FAVORITES COLLECTION
    // ============================================================================
    match /favorites/{favoriteId} {
      // Users can only access/modify their own favorites
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // ============================================================================
    // 6. NOTIFICATIONS COLLECTION
    // ============================================================================
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ============================================================================
    // 7. MODERATION LOGS (Audit Trail)
    // ============================================================================
    match /moderationLogs/{logId} {
      allow read: if isModerator();
      allow create: if isModerator();
      allow update, delete: if false;
    }
  }
}
